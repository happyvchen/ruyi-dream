# Runtime configuration for local development and Docker Compose.
# Copy this root-level file to .env. Backend local runs read the same .env.

COMPOSE_PROJECT_NAME=ruyi-dream
# Default local/private deployment includes RustFS. For external S3-compatible
# storage, set COMPOSE_FILE=docker-compose.yml and point APP_S3_* to the provider.
COMPOSE_FILE=docker-compose.yml:docker-compose.rustfs.yml
APP_ENV=development

# Browser app gate with fixed user/admin accounts.
# Local development may leave all account passwords empty to skip the login page.
# Recommended production setup: set APP_USER_PASSWORD_HASH, APP_ADMIN_PASSWORD_HASH,
# and APP_SESSION_SECRET. Use APP_*_PASSWORD only for local development.
# If any password/hash must be rotated and all existing sessions must be invalidated,
# rotate APP_SESSION_SECRET at the same time.
# Set APP_TRUST_REVERSE_PROXY_AUTH=true only when an external gateway handles auth.
APP_USER_USERNAME=user
APP_USER_PASSWORD=
APP_USER_PASSWORD_HASH=
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_ADMIN_PASSWORD_HASH=
APP_SESSION_SECRET=
APP_SESSION_TTL_SECONDS=43200
# Keep false for local HTTP. Set true only when the browser accesses the app over HTTPS.
APP_SESSION_COOKIE_SECURE=false
# Optional ops/script token. Do not rely on this as the browser app gate.
APP_API_ACCESS_TOKEN=
APP_TRUST_REVERSE_PROXY_AUTH=false

# Public URLs opened by the browser.
FRONTEND_PORT=5173
BACKEND_PORT=8000
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
PUBLIC_S3_URL=http://127.0.0.1:9000

# S3 compatible object storage.
# Local RustFS development may use admin/change-me with a fresh data directory.
# Existing RustFS data must be started with the same credentials used when it was created.
# Production must use strong random values.
# Leave unset for the default path-style S3 mode used by this app.
# Set only when deploying RustFS virtual-host style with matching DNS/reverse proxy.
# RUSTFS_SERVER_DOMAINS=s3.example.com
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
APP_S3_ENDPOINT_URL=http://127.0.0.1:9000
APP_S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
APP_S3_BUCKET=ruyi-dream
APP_S3_REGION=auto
APP_S3_FORCE_PATH_STYLE=true
APP_S3_PRESIGN_EXPIRES_SECONDS=900
APP_S3_ACCESS_KEY_ID=replace-with-access-key
APP_S3_SECRET_ACCESS_KEY=replace-with-secret-key
APP_MAX_UPLOAD_IMAGE_BYTES=15728640
APP_MAX_UPLOAD_IMAGE_PIXELS=25000000
APP_MAX_GARMENT_IMAGES_PER_SKU=20
APP_MAX_HEAD_REFERENCES_PER_PROFILE=20

# AI providers.
# Gemini 调用通道: toapis = ToAPIs OpenAI 兼容中转(国内可直连, 复用 TOAPIS_API_KEY);
# direct = google-genai SDK 直连 Google(需要能访问 googleapis.com, 使用 GEMINI_API_KEY)。
GEMINI_PROVIDER=toapis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# ToAPIs 通道的模型 ID; 留空则复用 GEMINI_MODEL。
GEMINI_TOAPIS_MODEL=gemini-3.5-flash
GEMINI_TOAPIS_TIMEOUT_SECONDS=300
# 连接+发送请求体超时(秒): 请求体内嵌 base64 图片, 部署环境上行慢时过小会报
# "The write operation timed out"(请求未到达 ToAPIs, 不计费)。
GEMINI_TOAPIS_CONNECT_TIMEOUT_SECONDS=60
GPT_IMAGE2_PROVIDER=toapis
GPT_IMAGE2_MODEL_ID=gpt-image-2
TOAPIS_API_KEY=
TOAPIS_BASE_URL=https://toapis.com
FAL_KEY=
GPT_IMAGE2_API_BASE_URL=https://fal.run/openai/gpt-image-2/edit
GPT_IMAGE2_QUEUE_URL=https://queue.fal.run/openai/gpt-image-2/edit
GPT_IMAGE2_SIZE=1:1
GPT_IMAGE2_RESOLUTION=1K
GPT_IMAGE2_QUALITY=high
GPT_IMAGE2_OUTPUT_FORMAT=png
GENERATION_POLL_INTERVAL_SECONDS=5
GENERATION_LOCK_TTL_SECONDS=120
GENERATION_IMAGE_TIMEOUT_SECONDS=1800
GENERATION_SUBMIT_RETRY_LIMIT=3
GENERATION_STATUS_RETRY_LIMIT=6

# CORS should include the public frontend URL.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
