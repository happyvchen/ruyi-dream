# 启动 Docker Compose 前，先复制本文件为 .env。
# 不要提交真实 .env 文件。

# 应用后端和运维人员访问 RustFS S3 API 使用的凭证。
# 生产环境必须使用足够长的随机值。
RUSTFS_ACCESS_KEY=replace-with-access-key
RUSTFS_SECRET_KEY=replace-with-secret-key

# 浏览器和后端可访问 RustFS 的公网/局域网域名或 IP。
# 示例：
# RUSTFS_SERVER_DOMAINS=192.168.1.20
# RUSTFS_SERVER_DOMAINS=rustfs.example.local
RUSTFS_SERVER_DOMAINS=localhost

# 宿主机端口。除非端口冲突，否则建议 9000 用于 S3 API，9001 用于 Console。
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# 应用 bucket。初始化/验收时创建。
APP_STORAGE_BUCKET=ruyi-dream
